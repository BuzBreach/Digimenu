{
  "name": "digital-menu-backend",
  "version": "1.0.0",
  "description": "Backend for premium cafe/bar/kitchen digital menu ordering system",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/prisma-run.js generate && node ./node_modules/typescript/bin/tsc && node scripts/copy-generated.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "node scripts/prisma-run.js generate",
    "prisma:migrate": "node scripts/prisma-run.js migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/prisma-run.js db push",
    "db:deploy": "node scripts/prisma-run.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.2",
    "tsx": "^4.7.1"
  }
}
