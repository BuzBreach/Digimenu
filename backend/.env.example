DATABASE_URL="postgresql://postgres:<password>@<supabase-pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:<password>@<supabase-direct-host>:5432/postgres?sslmode=require"
PORT=5000
JWT_SECRET="replace_with_a_unique_secret_for_this_client"
NODE_ENV="production"

# For browser or hosted frontend domains allowed to call backend APIs.
# Example:
# ALLOWED_ORIGINS="https://your-app.vercel.app,https://your-custom-domain.com"
ALLOWED_ORIGINS=""

CAFE_NAME="Client Cafe"
CAFE_LEGAL_NAME="Client Cafe, Bar & Kitchen"
CUSTOMER_OTP_ENABLED="false"

# Payment gateway. Keep blank/manual for offline-only cafes, or set to "phonepe".
PAYMENT_GATEWAY=""
PHONEPE_ENV="sandbox"
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_MERCHANT_ID=""
PHONEPE_BASE_URL=""
PHONEPE_AUTH_URL=""
PHONEPE_REDIRECT_URL=""
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""

# Choose one SMS provider for real OTP.
SMS_PROVIDER="fast2sms"
FAST2SMS_API_KEY=""
FAST2SMS_SENDER_ID="CAFE"

# Or use Twilio instead:
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# SMS_DEFAULT_COUNTRY_CODE="+91"
